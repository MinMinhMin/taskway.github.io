# For a GitHub project site, set the repository slug, for example: ai-gateway-docs
SITE_BASE_PATH=

# Optional site origin for canonical URLs and sitemap.
PUBLIC_SITE_URL=

# Optional destination for the “Open AI Gateway” link.
PUBLIC_APP_URL=

# Set the docs source repository if “Edit this page” links are desired.
PUBLIC_DOCS_REPOSITORY=

# Source folder within the docs repository, used by “Edit this page”.
PUBLIC_DOCS_PATH=sdk_tutorial_github_pages
