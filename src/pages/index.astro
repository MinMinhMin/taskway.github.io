---
const base = import.meta.env.BASE_URL;
const siteTitle = 'Taskway Docs';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" /><title>{siteTitle}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}icon.svg`} />
    <script is:inline define:vars={{ base }}>
      try {
        const saved = localStorage.getItem('gateway-docs-locale');
        const browserPref = navigator.languages?.some((language) => language.toLowerCase().startsWith('vi'));
        const locale = saved === 'vi' || (!saved && browserPref) ? 'vi' : 'en';
        location.replace(`${base}${locale}/`);
      } catch {}
    </script>
    <style>
      :root { font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: #211f32; background: #f7f7fc; font-synthesis: none; }
      body { min-height: 100vh; margin: 0; display: grid; place-items: center; padding: 24px; box-sizing: border-box; }
      main { width: min(480px, 100%); padding: 36px; border: 1px solid #dedff0; border-radius: 16px; background: #fff; }
      h1 { margin: 0; font-size: 25px; letter-spacing: -.04em; } p { color: #6b6d81; line-height: 1.65; }
      nav { display: flex; gap: 12px; margin-top: 26px; } a { flex: 1; padding: 12px; border: 1px solid #dedff0; border-radius: 9px; color: inherit; font-weight: 650; text-align: center; text-decoration: none; }
      a:first-child { color: white; border-color: #5b4fe5; background: #5b4fe5; } a:focus-visible { outline: 3px solid #22c7dc; outline-offset: 3px; }
      html[data-theme="dark"] { color: #f4f2ff; background: #0c1020; } html[data-theme="dark"] main { border-color: #323a57; background: #14192c; }
      html[data-theme="dark"] p { color: #adb0c7; } html[data-theme="dark"] a { border-color: #323a57; } html[data-theme="dark"] a:first-child { border-color: #b6a7ff; color: #170e34; background: #b6a7ff; }
    </style>
    <script is:inline>
      try { if (localStorage.getItem('gateway-docs-theme') === 'dark') document.documentElement.dataset.theme = 'dark'; } catch {}
    </script>
  </head>
  <body>
    <main><p class="eyebrow">TASKWAY · DOCS</p><h1>Choose your language</h1><p>Select a language to open the SDK documentation.</p>
      <nav><a href={`${base}en/`}>English</a><a href={`${base}vi/`}>Tiếng Việt</a></nav>
      <noscript><p lang="vi">JavaScript đã tắt. Hãy chọn ngôn ngữ để xem tài liệu.</p></noscript>
    </main>
  </body>
</html>
